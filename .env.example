# Agora.io App ID (required for Voice Rooms)
# Get yours free at https://console.agora.io
VITE_AGORA_APP_ID="your-agora-app-id-here"

# Firebase Configuration (override defaults in src/lib/firebase.ts)
# These are optional - defaults will be used if not set
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL="https://your-project-default-rtdb.firebaseio.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:aaaaaaaaaaaaaaaa"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Gemini AI API Key (for AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
